<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="CrossBrowserParallelSuite"
       parallel="tests"
       thread-count="2"
       preserve-order="true">

    <listeners>
        <listener class-name="utils.Listener"/>
    </listeners>

    <parameter name="url" value="https://www.saucedemo.com/"/>

    <!-- Chrome Execution -->
    <test name="ChromeTest">
        <parameter name="browser" value="chrome"/>

        <classes>
            <class name="test.TC_001_LoginTest"/>
            <class name="test.TC_002_ProductList"/>
            <class name="test.TC_003_AddToCart"/>
            <class name="test.TC_004_CheckOut"/>
        </classes>
    </test>

    <!-- Edge Execution -->
    <test name="EdgeTest">
        <parameter name="browser" value="edge"/>

        <classes>
            <class name="test.TC_001_LoginTest"/>
            <class name="test.TC_002_ProductList"/>
            <class name="test.TC_003_AddToCart"/>
            <class name="test.TC_004_CheckOut"/>
        </classes>
    </test>

</suite>